# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars

# ── Server ────────────────────────────────────────────────
PORT=4004

# ── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Suno AI ───────────────────────────────────────────────
SUNO_API_KEY=your_suno_api_key
SUNO_API_BASE_URL=https://api.sunoapi.org

# ── Callback URL (public URL where Suno can reach this service) ──────────────
# For local dev use ngrok: https://abc123.ngrok-free.app
CALLBACK_BASE_URL=http://localhost:4004

# ── Cloudinary (for audio file uploads) ──────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
