# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── JWT ───────────────────────────────────────────────────
# Access tokens expire in 15 minutes. Change this to a random 64-char secret.
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars

# ── Server ────────────────────────────────────────────────
PORT=4001

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: http://localhost:3000,https://yourdomain.com
# Leave empty or set to * to allow all origins (NOT recommended for production).
ALLOWED_ORIGINS=http://localhost:3000

# ── Cloudinary ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
