# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars

# ── Server ────────────────────────────────────────────────
PORT=4003

# ── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
